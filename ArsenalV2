-- Hitbox System
local function startHitboxSystem()
    local function getPlayersService()
        for i, v in pairs(game:GetChildren()) do
            if v.ClassName == "Players" then
                return v.Name
            end
        end
    end
    
    local playersService = getPlayersService()
    local localPlayer = game[playersService].LocalPlayer
    
    coroutine.resume(coroutine.create(function()
        while wait(0.5) do
            if not systemState.hitboxEnabled then break end
            coroutine.resume(coroutine.create(function()
                for _, target in pairs(game[playersService]:GetPlayers()) do
                    if target.Name ~= localPlayer.Name and target.Character then
                        pcall(function()
                            local parts = {"RightUpperLeg", "LeftUpperLeg", "HeadHB", "HumanoidRootPart"}
                            for _, partName in pairs(parts) do
                                local part = target.Character:FindFirstChild(partName)
                                if part then
                                    part.CanCollide = false
                                    part.Transparency = 0.15
                                    part.Size = Vector3.new(12, 12, 12)
                                    part.Material = Enum.Material.Neon
                                end
                            end
                        end)
                    end
                end
            end))
        end
    end))
end

-- ESP System
local function toggleESP()
    systemState.espEnabled = not systemState.espEnabled
    
    for _, target in pairs(Players:GetPlayers()) do
        if target ~= player and target.Character then
            pcall(function()
                local highlight = target.Character:FindFirstChild("Highlight")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Parent = target.Character
                end
                highlight.Enabled = systemState.espEnabled
                highlight.FillColor = systemState.espEnabled and Color3.fromRGB(255, 0, 0) or Color3.new()
                highlight.OutlineColor = systemState.espEnabled and Color3.fromRGB(255, 255, 255) or Color3.new()
                highlight.FillTransparency = systemState.espEnabled and 0.4 or 1
            end)
        end
    end
end

