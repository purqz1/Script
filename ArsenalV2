-- Tab Button Creation
local tabs = {}
local currentTab = nil

local function createTab(tabName, icon)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(0, 120, 1, 0)
    tabBtn.Position = UDim2.new(#tabs * 0.133, 0, 0, 0)
    tabBtn.BackgroundColor3 = CONFIG.Theme.Background
    tabBtn.BackgroundTransparency = 1
    tabBtn.BorderSizePixel = 0
    tabBtn.Text = icon .. " " .. tabName
    tabBtn.TextColor3 = CONFIG.Theme.TextDim
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextScaled = true
    tabBtn.Parent = tabContainer
    
    local tabCorner = Instance.new("UICorner")
    tabCorner.CornerRadius = UDim.new(0, 0)
    tabCorner.Parent = tabBtn
    
    -- Tab underline
    local underline = Instance.new("Frame")
    underline.Size = UDim2.new(0.8, 0, 0, 2)
    underline.Position = UDim2.new(0.1, 0, 1, -2)
    underline.BackgroundColor3 = CONFIG.Theme.Primary
    underline.BackgroundTransparency = 1
    underline.BorderSizePixel = 0
    underline.Parent = tabBtn
    
    local tabData = {
        Button = tabBtn,
        Underline = underline,
        Name = tabName
    }
    
    table.insert(tabs, tabData)
    return tabData
end

