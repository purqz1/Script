local function animateLoading()
    local progress = 0
    local loadingTexts = {
        "Establishing Connection...",
        "Loading Modules...",
        "Initializing UI...",
        "Configuring Environment...",
        "Applying Security Protocols...",
        "Finalizing Setup..."
    }
    
    for i = 1, 100 do
        progress = i
        progressBar.Size = UDim2.new(progress / 100, 0, 1, 0)
        progressText.Text = progress .. "%"
        
        local textIndex = math.floor((progress / 100) * #loadingTexts)
        if textIndex > 0 and textIndex <= #loadingTexts then
            loadingSubtitle.Text = loadingTexts[textIndex]
        end
        
        logoRing.BackgroundTransparency = 0.8 - (progress / 100) * 0.5
        logoRing.Size = UDim2.new(1 + (progress / 100) * 0.3, 0, 1 + (progress / 100) * 0.3, 0)
        logoRing.Rotation = progress * 3.6
        
        wait(0.02)
    end
    
    loadingTitle.Text = "SYSTEM READY"
    loadingSubtitle.Text = "Authentication Required"
    progressText.Text = "100%"
    
    wait(0.5)
    
    tweenService:Create(loadingScreen, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 1
    }):Play()
    
    wait(0.8)
    loadingScreen.Visible = false
end

