end

createMainUI()

-- Key Button Function
keyButton.MouseButton1Click:Connect(function()
    if keyBox.Text == key then
        statusLabel.Text = "✅ ACCESS GRANTED"
        statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        wait(0.5)
        background.Visible = false
        mainUI.Visible = true
    else
        statusLabel.Text = "❌ INVALID KEY"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        keyBox.Text = ""
    end
end)

-- Enter key support
keyBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        keyButton.MouseButton1Click:Fire()
    end
end)

-- Original Script (Modified to be toggled)
local enabled = false

-- Your original function
local function getplrsname()
    for i,v in pairs(game:GetChildren()) do
        if v.ClassName == "Players" then
            return v.Name
        end
    end
end

local function startScript()
    local players = getplrsname()
    local plr = game[players].LocalPlayer
    
    coroutine.resume(coroutine.create(function()
        while wait(1) do
            if not enabled then break end
            coroutine.resume(coroutine.create(function()
                for _,v in pairs(game[players]:GetPlayers()) do
                    if v.Name ~= plr.Name and v.Character then
                        pcall(function()
                            v.Character.RightUpperLeg.CanCollide = false
                            v.Character.RightUpperLeg.Transparency = 0.3
                            v.Character.RightUpperLeg.Size = Vector3.new(13,13,13)
                            
                            v.Character.LeftUpperLeg.CanCollide = false
                            v.Character.LeftUpperLeg.Transparency = 0.3
                            v.Character.LeftUpperLeg.Size = Vector3.new(13,13,13)
                            
                            v.Character.HeadHB.CanCollide = false
                            v.Character.HeadHB.Transparency = 0.3
                            v.Character.HeadHB.Size = Vector3.new(13,13,13)
                            
                            v.Character.HumanoidRootPart.CanCollide = false
                            v.Character.HumanoidRootPart.Transparency = 0.3
                            v.Character.HumanoidRootPart.Size = Vector3.new(13,13,13)
                        end)
                    end
                end
            end))
        end
    end))
end

