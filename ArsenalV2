            ColorSequenceKeypoint.new(0, Color3.fromRGB(50, 20, 100)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 50, 100))
        })
        gradient2.Parent = btn
    end
    
    -- Hitbox Size Slider
    local sliderFrame = Instance.new("Frame")
    sliderFrame.Size = UDim2.new(0.35, 0, 0.25, 0)
    sliderFrame.Position = UDim2.new(0.05, 0, 0.1, 0)
