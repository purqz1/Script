local espEnabled = false
local espBtn = Instance.new("TextButton")
espBtn.Size = UDim2.new(0.3, 0, 0.08, 0)
espBtn.Position = UDim2.new(0.35, 0, 0.65, 0)
espBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 45)
espBtn.BorderColor3 = Color3.fromRGB(100, 50, 200)
espBtn.BorderSizePixel = 2
espBtn.Text = "👁 ESP OFF"
espBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
espBtn.Font = Enum.Font.GothamBold
espBtn.TextScaled = true
espBtn.Parent = mainUI

espBtn.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    espBtn.Text = espEnabled and "👁 ESP ON" or "👁 ESP OFF"
    
    -- Simple ESP implementation
    for _,v in pairs(game:GetService("Players"):GetPlayers()) do
        if v ~= game.Players.LocalPlayer and v.Character then
            if v.Character:FindFirstChild("Head") then
                local highlight = Instance.new("Highlight")
                highlight.Parent = v.Character
                highlight.Enabled = espEnabled
                highlight.FillColor = espEnabled and Color3.fromRGB(255, 0, 0) or Color3.new()
                highlight.OutlineColor = espEnabled and Color3.fromRGB(255, 255, 255) or Color3.new()
            end
        end
    end
end)

