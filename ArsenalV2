-- Credit Cards
local credits = {
    {title = "SCRIPT DEVELOPER", name = "Purqz", desc = "Lead Developer & Architect", color = CONFIG.Theme.Primary},
    {title = "UI DESIGNER", name = "Purqz", desc = "Interface Design & Experience", color = CONFIG.Theme.Secondary},
    {title = "SYSTEM ENGINEER", name = "Purqz", desc = "Core Systems & Optimization", color = CONFIG.Theme.Success},
    {title = "TESTING & QA", name = "Purqz", desc = "Quality Assurance & Testing", color = CONFIG.Theme.Warning}
}

for i, credit in ipairs(credits) do
    local row = math.floor((i-1) / 2)
    local col = (i-1) % 2
    
    local creditCard = Instance.new("Frame")
    creditCard.Size = UDim2.new(0.45, 0, 0.40, 0)
    creditCard.Position = UDim2.new(0.02 + col * 0.51, 0, 0.05 + row * 0.45, 0)
    creditCard.BackgroundColor3 = CONFIG.Theme.Card
    creditCard.BackgroundTransparency = 0.2
    creditCard.BorderSizePixel = 0
    creditCard.Parent = creditsGrid
    
    local cardCorner = Instance.new("UICorner")
    cardCorner.CornerRadius = UDim.new(0, 8)
    cardCorner.Parent = creditCard
    
    -- Credit icon/avatar placeholder
    local avatarFrame = Instance.new("Frame")
    avatarFrame.Size = UDim2.new(0, 60, 0, 60)
    avatarFrame.Position = UDim2.new(0.05, 0, 0.15, 0)
    avatarFrame.BackgroundColor3 = credit.color
    avatarFrame.BackgroundTransparency = 0.3
    avatarFrame.BorderSizePixel = 0
    avatarFrame.Parent = creditCard
    
    local avatarCorner = Instance.new("UICorner")
    avatarCorner.CornerRadius = UDim.new(1, 0)
    avatarCorner.Parent = avatarFrame
    
    local avatarText = Instance.new("TextLabel")
    avatarText.Size = UDim2.new(1, 0, 1, 0)
    avatarText.Position = UDim2.new(0, 0, 0, 0)
    avatarText.BackgroundTransparency = 1
    avatarText.Text = string.sub(credit.name, 1, 1)
    avatarText.TextColor3 = CONFIG.Theme.Text
    avatarText.TextScaled = true
    avatarText.Font = Enum.Font.GothamBold
    avatarText.Parent = avatarFrame
    
    local creditTitle = Instance.new("TextLabel")
    creditTitle.Size = UDim2.new(0.65, 0, 0, 25)
    creditTitle.Position = UDim2.new(0.3, 0, 0.2, 0)
    creditTitle.BackgroundTransparency = 1
    creditTitle.Text = credit.title
    creditTitle.TextColor3 = CONFIG.Theme.TextDim
    creditTitle.TextScaled = true
    creditTitle.Font = Enum.Font.Gotham
    creditTitle.TextXAlignment = Enum.TextXAlignment.Left
    creditTitle.Parent = creditCard
    
    local creditName = Instance.new("TextLabel")
    creditName.Size = UDim2.new(0.65, 0, 0, 35)
