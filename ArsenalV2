    slider.Position = UDim2.new(0.1, 0, 0.8, 0)
    slider.BackgroundColor3 = Color3.fromRGB(100, 50, 200)
    slider.Parent = sliderFrame
    
    local sliderButton = Instance.new("TextButton")
