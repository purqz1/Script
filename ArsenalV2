-- ============================================
-- TAB SWITCHING
-- ============================================
local function switchTab(tabName)
    currentTab = tabName
    
    -- Update tab buttons
    for name, data in pairs(tabButtons) do
        if name == tabName then
            data.Button.TextColor3 = CONFIG.Theme.Text
            data.Underline.BackgroundTransparency = 0
        else
            data.Button.TextColor3 = CONFIG.Theme.TextDim
            data.Underline.BackgroundTransparency = 1
        end
    end
    
    -- Show correct tab content
    local tabs = {mainTab, espTab, settingsTab, creditsTab}
    local tabNames = {"MAIN", "ESP", "SETTINGS", "CREDITS"}
    
    for i, tab in ipairs(tabs) do
        tab.Visible = (tabNames[i] == tabName)
    end
end

-- Tab button connections
for name, data in pairs(tabButtons) do
    data.Button.MouseButton1Click:Connect(function()
        switchTab(name)
    end)
end

